# Copy this file to ".env" (same folder) and paste your own key after the "=".
# .env is listed in .gitignore, so it is never uploaded to GitHub.
# Create / revoke keys at https://aistudio.google.com/apikey
GEMINI_API_KEY=paste-your-key-here

# optional: default chat model
GEMINI_MODEL=gemini-3.5-flash-lite
